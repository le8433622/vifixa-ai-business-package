# Vifixa AI — Environment Template
# Copy to .env.local for local orchestration only.
# Never commit real values.

# Public Supabase values for browser/mobile clients
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only Supabase values
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_SERVICE_ROLE_KEY=replace-in-secret-store-only
SUPABASE_ACCESS_TOKEN=replace-in-ci-secret-only

# AI providers
OPENAI_API_KEY=replace-in-secret-store-only
NVIDIA_API_KEY=replace-in-secret-store-only
ANTHROPIC_API_KEY=replace-in-secret-store-only

# Payments
VNPAY_TMN_CODE=replace-in-secret-store-only
VNPAY_HASH_SECRET=replace-in-secret-store-only
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
STRIPE_SECRET_KEY=replace-in-secret-store-only
STRIPE_WEBHOOK_SECRET=replace-in-secret-store-only
PAYOS_CLIENT_ID=replace-in-secret-store-only
PAYOS_API_KEY=replace-in-secret-store-only
PAYOS_CHECKSUM_KEY=replace-in-secret-store-only

# Maps / geo
GOOGLE_MAPS_API_KEY=replace-in-secret-store-only
MAPBOX_ACCESS_TOKEN=replace-in-secret-store-only

# Messaging / OTP
TWILIO_ACCOUNT_SID=replace-in-secret-store-only
TWILIO_AUTH_TOKEN=replace-in-secret-store-only
TWILIO_PHONE_NUMBER=replace-in-secret-store-only

# Search / enrichment optional
BRAVE_SEARCH_API_KEY=replace-in-secret-store-only

# Vercel CLI optional
VERCEL_ORG_ID=your-vercel-org-id
VERCEL_PROJECT_ID=your-vercel-project-id
VERCEL_TOKEN=replace-in-ci-secret-only

# Test user for staging smoke tests
TEST_USER_EMAIL=customer.test@example.com
TEST_USER_PASSWORD=replace-in-ci-secret-only
