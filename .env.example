# Vifixa AI — Environment Variables (copy to .env.local)
# NEVER commit .env or .env.local to git
# Payment keys are stored in Supabase Secrets (not .env) for security

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role (for webhooks only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NVIDIA NIM (AI Core)
NVIDIA_API_KEY=your-nvidia-api-key

# Payment Gateway Keys — Store these in Supabase Dashboard → Settings → API → Secrets
# Do NOT put them in .env files
# VNPay: Set via Supabase SQL or Dashboard (sandbox keys in migration, real keys in Secrets)
# Stripe: Set via Supabase Secrets as STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET

# Search (optional)
BRAVE_SEARCH_API_KEY=your-brave-api-key
