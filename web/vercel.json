{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "redirects": [
    {
      "source": "/v4(.*)",
      "destination": "/",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/ai-scheduler",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/cleanup-idempotency",
      "schedule": "0 3 * * 0"
    }
  ]
}
